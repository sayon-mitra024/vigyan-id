# Firebase client SDK (public, safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=                                                                                                                                                                                                                 
# Firebase Admin SDK (server-only secrets — never expose to the client)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Institution issuer Ed25519 signing key (server-only secret, hex-encoded 32-byte seed).
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit a real value. NEVER store this in Firestore. If unset and Firebase Admin
# is also unset, a fixed non-production demo key is used automatically (demo mode only).
ISSUER_ED25519_PRIVATE_KEY_HEX=

# Optional comma-separated allow-list of trusted issuer DIDs for public verification.
# If empty, any structurally valid did:key issuer is trusted (fine for a single-institution demo).
TRUSTED_ISSUER_DIDS=

# Gmail SMTP (server-only secrets — never expose to the client)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Email address that receives correction-submitted notifications (the registrar/issuer inbox)
ISSUER_NOTIFICATION_EMAIL=

# Demo-mode session signing secret (only used when Firebase Admin is not configured)
DEMO_SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default institution assigned only to newly registered students.
# Issuer institution membership is provisioned server-side and never taken from the browser.
DEFAULT_INSTITUTION_ID=
DEFAULT_INSTITUTION_NAME=
